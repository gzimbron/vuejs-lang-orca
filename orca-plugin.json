{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "data",
  "id": "vuejs-lang",
  "name": "Vue.js Syntax",
  "version": "1.0.0",
  "description": "Self-contained syntax highlighting for Vue single-file components (.vue).",
  "author": { "name": "Gustavo Zimbrón", "url": "https://github.com/gzimbron" },
  "repository": "https://github.com/gzimbron/vuejs-lang-orca",
  "license": "MIT",
  "engines": { "orca": ">=1.4.246" },
  "capabilities": [],
  "contributes": {
    "syntaxes": [
      {
        "id": "vue",
        "title": "Vue.js",
        "scopeName": "text.html.vue",
        "path": "syntaxes/vue.tmLanguage.json",
        "configuration": "syntaxes/language-configuration.json",
        "extensions": [".vue"]
      }
    ]
  }
}
